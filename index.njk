<style>
    .hero-slide { opacity: 0; transition: opacity 1s ease-in-out; }
    .hero-slide.active { opacity: 1; }
    @media (prefers-reduced-motion: reduce) {
        .hero-slide { transition: none; }
        .hero-slide.active { opacity: 1; }
    }
    
    /* Swiper Navigation Button Styling */
    .offers-swiper .swiper-button-next,
    .offers-swiper .swiper-button-prev {
        color: #FFFFFF !important; /* White icon arrow */
        background-color: #C85A32 !important; /* Your site's rust/orange color */
        width: 36px;
        height: 36px;
        border-radius: 9999px;
        transition: background-color 0.2s ease, transform 0.2s ease;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    }
    
    .offers-swiper .swiper-button-next:after,
    .offers-swiper .swiper-button-prev:after {
        font-size: 14px !important;
        font-weight: bold;
    }
    
    .offers-swiper .swiper-button-next:hover,
    .offers-swiper .swiper-button-prev:hover {
        background-color: #A03D49 !important; /* Burgundy highlight on hover */
        transform: scale(1.05);
    }
</style>

<!-- Hero Section -->
<section class="relative bg-ink text-cream py-24 px-4 text-center overflow-hidden">
    <div class="absolute inset-0 bg-cover bg-center hero-slide active" style="background-image: url('img/hero-carousel/herocarousel-001_720p.webp');" aria-hidden="true"></div>
    <div class="absolute inset-0 bg-cover bg-center hero-slide" style="background-image: url('img/hero-carousel/herocarousel-002_720p.webp');" aria-hidden="true"></div>
    <div class="absolute inset-0 bg-cover bg-center hero-slide" style="background-image: url('img/hero-carousel/herocarousel-003_720p.webp');" aria-hidden="true"></div>
    <div class="absolute inset-0 bg-cover bg-center hero-slide" style="background-image: url('img/hero-carousel/herocarousel-004_720p.webp');" aria-hidden="true"></div>
    <div class="absolute inset-0 bg-cover bg-center hero-slide" style="background-image: url('img/hero-carousel/herocarousel-005_720p.webp');" aria-hidden="true"></div>
    <div class="absolute inset-0 bg-cover bg-center hero-slide" style="background-image: url('img/hero-carousel/herocarousel-006_720p.webp');" aria-hidden="true"></div>
    <div class="absolute inset-0 bg-ink opacity-60"></div>
    <div class="absolute inset-0 bg-teal opacity-20"></div>
    <div class="relative max-w-4xl mx-auto z-10">
        <h1 class="text-4xl md:text-6xl font-bold mb-6 uppercase tracking-wide text-white">{{ hero.title | safe }}</h1>
        <p class="text-xl mb-8 max-w-2xl mx-auto">{{ hero.subtitle }}</p>
        <div class="flex justify-center space-x-4">
            <a href="#latest" class="bg-rust hover:bg-white hover:text-rust text-white font-bold py-3 px-6 rounded uppercase tracking-wider transition">{{ hero.button_text }}</a>
        </div>
    </div>
</section>

<!-- Listener Offers Section -->
<section aria-labelledby="listener-offers" class="bg-teal text-cream px-4 py-5 overflow-hidden">
    <div class="max-w-7xl mx-auto">
        <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-2 mb-4">
            <div>
                <p class="text-xs font-bold uppercase tracking-widest text-tan mb-1">{{ offers_section.eyebrow }}</p>
                <h2 id="listener-offers" class="text-xl md:text-2xl font-bold uppercase tracking-wide">{{ offers_section.title }}</h2>
            </div>
            <a href="{{ offers_section.link_url }}" class="text-xs font-bold uppercase tracking-wider text-tan hover:text-white transition">{{ offers_section.link_text | safe }}</a>
        </div>

        <p class="text-xs font-bold uppercase tracking-widest text-tan mb-3">Partner offers</p>
        
        <!-- Swiper Carousel Outer Container with Side Controls and Fades -->
        <div class="relative px-6">
            
            <!-- Left & Right Gradient Overlay Fades (Matches bg-teal) -->
            <div class="absolute top-0 left-0 bottom-0 w-16 bg-gradient-to-r from-teal to-transparent z-10 pointer-events-none"></div>
            <div class="absolute top-0 right-0 bottom-0 w-16 bg-gradient-to-l from-teal to-transparent z-10 pointer-events-none"></div>

            <!-- Main Swiper Container -->
            <div class="swiper offers-swiper overflow-hidden">
                <div class="swiper-wrapper">
                    
                    {% for offer in offers %}
                    <div class="swiper-slide h-auto">
                        <article class="bg-white text-ink rounded-lg overflow-hidden shadow-lg flex flex-col h-full">
                            <img src="{{ offer.image }}" alt="Partner image" class="w-full h-20 object-cover grayscale opacity-80 hover:grayscale-0 hover:opacity-100 transition duration-700 ease-in-out" />
                            <div class="p-4 flex flex-col flex-grow">
                                <p class="text-xs font-bold uppercase tracking-widest text-rust mb-1">{{ offer.eyebrow }}</p>
                                <h3 class="text-lg font-bold text-burgundy mb-1">{{ offer.title }}</h3>
                                <p class="text-xs text-gray-600 mb-3 flex-grow">{{ offer.description }}</p>
                                <a href="{{ offer.link_url }}" target="_blank" rel="noopener noreferrer" class="text-xs font-bold uppercase tracking-wider text-teal hover:text-rust transition">{{ offer.link_text | safe }}</a>
                            </div>
                        </article>
                    </div>
                    {% endfor %}

                    <!-- Club Offer Slide -->
                    <div class="swiper-slide h-auto">
                        <article class="bg-cream text-ink rounded-lg overflow-hidden shadow-lg border-2 border-rust flex flex-col h-full">
                            <img src="{{ club_offer.image }}" alt="Club image" class="w-full h-20 object-cover grayscale opacity-80 hover:grayscale-0 hover:opacity-100 transition duration-700 ease-in-out" />
                            <div class="p-4 flex flex-col flex-grow">
                                <p class="text-xs font-bold uppercase tracking-widest text-rust mb-1">{{ club_offer.eyebrow }}</p>
                                <h3 class="text-lg font-bold text-burgundy mb-1">{{ club_offer.title }}</h3>
                                <p class="text-xs text-gray-700 mb-3 flex-grow">{{ club_offer.description }}</p>
                                <a href="{{ club_offer.link_url }}" class="text-xs font-bold uppercase tracking-wider text-teal hover:text-rust transition">{{ club_offer.link_text | safe }}</a>
                            </div>
                        </article>
                    </div>

                </div>
            </div>

            <!-- Navigation Buttons -->
            <div class="swiper-button-prev !-left-2 z-20"></div>
            <div class="swiper-button-next !-right-2 z-20"></div>
        </div>
    </div>
</section>

<div class="max-w-7xl mx-auto px-4 py-16">
    <!-- Latest Episode -->
    <section id="latest" class="mb-20">
        <h2 class="text-3xl font-bold text-burgundy mb-6 uppercase tracking-wider">{{ latest_episode.title }}</h2>
        <div class="bg-white rounded-lg shadow-xl overflow-hidden border border-tan/30">
            <div class="aspect-w-16 aspect-h-9 bg-ink relative" style="padding-top: 56.25%;">
                <iframe class="absolute top-0 left-0 w-full h-full" src="https://www.youtube-nocookie.com/embed/{{ latest_episode.youtube_id }}" title="Vintage Politics Latest Episode" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe>
            </div>
            <div class="p-6">
                <h3 class="text-2xl font-bold text-ink mb-2"><a href="{{ latest_episode.episode_url }}" class="hover:text-rust transition">{{ latest_episode.episode_title | safe }}</a></h3>
                <p class="text-gray-700 mb-4">{{ latest_episode.description }}</p>
            </div>
        </div>
    </section>
    
    <!-- The Format -->
    <section class="mb-20 bg-teal text-cream p-10 rounded-lg text-center shadow-lg">
        <h2 class="text-3xl font-bold mb-4 uppercase tracking-wider">{{ format_section.title }}</h2>
        <p class="text-lg max-w-3xl mx-auto">{{ format_section.description }}</p>
    </section>
</div>

<!-- Scripts -->
<script>
    // Hero Slideshow Script
    const heroSlides = document.querySelectorAll('.hero-slide');
    let activeSlide = 0;

    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        window.setInterval(() => {
            heroSlides[activeSlide].classList.remove('active');
            activeSlide = (activeSlide + 1) % heroSlides.length;
            heroSlides[activeSlide].classList.add('active');
        }, 18000);
    }

    // Offers Swiper Script
    document.addEventListener('DOMContentLoaded', function () {
        const offersSwiper = new Swiper('.offers-swiper', {
            loop: true,
            centeredSlides: false,
            spaceBetween: 16,
            slidesPerView: 1.2, // Mobile default: 1 full card + partial edge
            breakpoints: {
                640: {
                    slidesPerView: 2.2, // Tablet
                    spaceBetween: 16
                },
                1024: {
                    slidesPerView: 3.2, // Desktop: 3 cards in view + 4th partially visible
                    spaceBetween: 20
                }
            },
            navigation: {
                nextEl: '.swiper-button-next',
                prevEl: '.swiper-button-prev',
            },
        });
    });
</script>