---
layout: base.njk
---
<div class="flex-grow max-w-4xl mx-auto w-full px-4 py-12">
    <a href="/partners.html" class="inline-block mb-8 text-xs font-bold uppercase tracking-wider text-teal hover:text-rust transition">
        &larr; Back to All Partners
    </a>

    <article class="bg-white p-8 md:p-12 rounded-lg shadow-md border border-tan/30">
        {% if image or logo %}
        <img src="{{ image or logo }}" alt="{{ title }}" class="w-full h-72 object-cover rounded mb-8 shadow-sm" />
        {% endif %}

        <h1 class="text-3xl md:text-4xl font-bold text-burgundy uppercase tracking-wide mb-4">{{ title }}</h1>
        
        {% if description or tagline %}
        <p class="text-lg text-ink font-semibold mb-6 border-b border-tan/30 pb-6">{{ description or tagline }}</p>
        {% endif %}

        <div class="prose max-w-none text-gray-700 leading-relaxed mb-8">
            {{ content | safe }}
        </div>

        {% if url %}
        <a href="{{ url }}" target="_blank" rel="noopener noreferrer" class="inline-block bg-teal text-white font-bold py-3 px-6 rounded uppercase tracking-wider hover:bg-rust transition">
            Visit Partner Website &rarr;
        </a>
        {% endif %}
    </article>
</div>