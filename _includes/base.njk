    <!-- GLOBAL FOOTER -->
    <footer class="bg-ink text-cream pt-12 pb-6 border-t border-tan/20 mt-auto">
        <div class="text-center text-xs opacity-50 uppercase tracking-widest pt-6">&copy; 2026 Vintage Politics Ltd. All rights reserved.</div>
