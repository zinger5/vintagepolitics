{
  "paths": {
    "uploads": "img",
    "static": ""
  },
  "collections_config": {
  "episodes": {
    "path": "episodes"
  },
  "pages": {
    "path": "",
    "glob": [
      "*.njk",
      "*.md",
      "*.html"
    ],
    "name": "Pages",
    "icon": "wysiwyg"
  }
}
  "_inputs": {
    "date": {
      "type": "date"
    },
    "image_path": {
      "type": "image"
    },
    "season_info": {
      "type": "text",
      "comment": "e.g., Series 2, Episode 1"
    },
    "wines": {
      "type": "array",
      "options": {
        "item_name": "Wine"
      }
    },
    "profile_image": { 
        "type": "image" 
    },
    "partners[*].image": {
        "type": "image"
    },
    "hosts[*].image": {
        "type": "image"
    },
    "offers[*].image": {
        "type": "image"
    },
    "club_offer.image": {
        "type": "image"
    }
  }
}