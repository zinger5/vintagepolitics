{
  "paths": {
    "uploads": "uploads",
    "static": "",
    "output": "_site"
  },
  "_enabled_editors": [
    "visual",
    "content"
  ],
  "collections_config": {
    "episodes": {
      "path": "episodes",
      "glob": "*.md",
      "name": "Episodes",
      "icon": "ondemand_video",
      "output": true,
      "data_config": true,
      "add_options": [
        {
          "name": "Add Episode",
          "schema": "default"
        }
      ],
      "schemas": {
        "default": {
          "name": "New Episode",
          "remove_extra_inputs": true,
          "value": {
            "_schema": "default",
            "title": "",
            "youtube_id": "",
            "episode_title": "",
            "description": "",
            "date": null
          }
        }
      }
    },
    "partners": {
      "path": "partners",
      "glob": "*.md",
      "name": "Partners",
      "icon": "handshake",
      "output": true,
      "_enabled_editors": [
        "data",
        "content"
      ],
      "add_options": [
        {
          "name": "Add Partner",
          "schema": "default"
        }
      ],
      "schemas": {
        "default": {
          "name": "New Partner",
          "remove_extra_inputs": true,
          "value": {
            "_schema": "default",
            "layout": "partner.njk",
            "tags": "partners",
            "order": 10,
            "title": "",
            "description": "",
            "tagline": "",
            "logo": "",
            "hero_image": "",
            "offer_code": "",
            "url": "",
            "draft": false
          }
        }
      }
    },
    "pages": {
      "path": "",
      "glob": [
        "*.njk",
        "*.md",
        "*.html"
      ],
      "name": "Pages",
      "icon": "wysiwyg"
    }
  },
  "_inputs": {
    "draft": {
      "type": "checkbox",
      "label": "Draft Mode (Hide from live site)"
    },
    "offers[*].draft": {
      "type": "checkbox",
      "label": "Draft Mode (Hide from live site)",
      "comment": "Check this box to save without publishing to the homepage"
    },
    "club_offer.draft": {
      "type": "checkbox",
      "label": "Draft Mode (Hide from live site)"
    },
    "date": {
      "type": "date"
    },
    "image": {
      "type": "image"
    },
    "logo": {
      "type": "image"
    },
    "hero_image": {
      "type": "image"
    },
    "image_path": {
      "type": "image"
    },
    "season_info": {
      "type": "text",
      "comment": "e.g., Series 2, Episode 1"
    },
    "wines": {
      "type": "array",
      "options": {
        "item_name": "Wine"
      }
    },
    "profile_image": {
      "type": "image"
    },
    "partners[*].image": {
      "type": "image"
    },
    "hosts[*].image": {
      "type": "image"
    },
    "offers[*].image": {
      "type": "image"
    },
    "club_offer.image": {
      "type": "image"
    },
    "order": {
      "type": "number",
      "label": "Display Order",
      "comment": "Lower numbers appear first (e.g., 1, 2, 3)"
    }
  }
}