{
  "paths": {
    "uploads": "uploads",
    "static": ""
  },
  "collections_config": {
    "episodes": {
      "path": "episodes",
      "glob": "*.md",
      "name": "Episodes",
      "icon": "ondemand_video",
      "output": true,
      "add_options": [
        {
          "name": "Add Episode",
          "schema": "default"
        }
      ],
      "schemas": {
        "default": {
          "name": "New Episode",
          "remove_extra_inputs": true,
          "value": {
            "_schema": "default",
            "title": "",
            "youtube_id": "",
            "episode_title": "",
            "description": "",
            "date": null
          }
        }
      }
    },
    "pages": {
      "path": "",
      "glob": [
        "*.njk",
        "*.md",
        "*.html"
      ],
      "name": "Pages",
      "icon": "wysiwyg"
    }
  },
  "_inputs": {
    "date": {
      "type": "date"
    },
    "image_path": {
      "type": "image"
    },
    "season_info": {
      "type": "text",
      "comment": "e.g., Series 2, Episode 1"
    },
    "wines": {
      "type": "array",
      "options": {
        "item_name": "Wine"
      }
    },
    "profile_image": {
      "type": "image"
    },
    "partners[*].image": {
      "type": "image"
    },
    "hosts[*].image": {
      "type": "image"
    },
    "offers[*].image": {
      "type": "image"
    },
    "club_offer.image": {
      "type": "image"
    }
  }
}