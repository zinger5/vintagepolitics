{
  "paths": {
    "uploads": "img",
    "static": ""
  },
  "collections_config": {
    "episodes": {
      "path": "episodes",
      "url": "/episodes/{slug}/",
      "name": "Episodes",
      "singular_name": "Episode",
      "schemas": {
        "default": {
          "path": ".cloudcannon/schemas/episode.md"
        }
      }
    }
  },
  "_inputs": {
    "date": {
      "type": "date"
    },
    "image_path": {
      "type": "image"
    },
    "season_info": {
      "type": "text",
      "comment": "e.g., Series 2, Episode 1"
    },
    "wines": {
      "type": "array",
      "options": {
        "item_name": "Wine"
      }
    },
    "profile_image": { 
        "type": "image" 
    },
    "partners[*].image": {
        "type": "image"
    },
    "hosts[*].image": {
        "type": "image"
    },
    "offers[*].image": {
        "type": "image"
    },
    "club_offer.image": {
        "type": "image"
    }
  }
}